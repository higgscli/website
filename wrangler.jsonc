{
  // Cloudflare Worker serving the higgscli.com static marketing site.
  // Assets in ./public are served at the edge via the ASSETS binding;
  // agent discoverability comes from static files (/llms.txt, /llms-full.txt,
  // /robots.txt, /sitemap.xml) plus JSON-LD and <link rel="alternate"> in the
  // page head — no per-request content negotiation.
  //
  // src/index.js wraps asset serving with DataFast AI-crawler tracking.
  // run_worker_first is required: without it, asset-matched requests (i.e.
  // the entire site) would be served before the Worker runs and no crawler
  // hit would ever be recorded.
  "name": "higgscli",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Version Preview URLs (<version>-higgscli.<subdomain>.workers.dev and
  // `--preview-alias` URLs) for `wrangler versions upload`, so site changes
  // can be reviewed before they reach higgscli.com. The workers.dev route
  // itself stays off (routes are custom domains, so workers_dev defaults to
  // false). Takes effect on the next `wrangler deploy`.
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "higgscli.com", "custom_domain": true },
    { "pattern": "www.higgscli.com", "custom_domain": true }
  ]
}
